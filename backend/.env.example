# Copy to backend/.env and fill in your values. Never commit .env.
JTAP_SECRET_KEY=replace-with-a-long-random-string
DATA_DIR=.
# Google Sign-In: web OAuth client ID from Google Cloud Console
# (APIs & Services > Credentials). Required for POST /auth/google.
GOOGLE_WEB_CLIENT_ID=paste-your-google-web-client-id-here
# Optional: Android / iOS OAuth client IDs. Needed once those clients exist in
# Google Cloud Console (tokens minted for them carry their own client ID).
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
# Email verification (SMTP): dedicated Gmail account that sends the
# verification codes. The Gmail account needs 2FA + an app password
# (not the account password). Required for POST /auth/email-verification/request.
# SMTP_PASS also accepts SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=paste-your-dedicated-gmail-address-here
SMTP_PASS=paste-your-gmail-app-password-here
SMTP_FROM=paste-your-dedicated-gmail-address-here
# Login CAPTCHA (hCaptcha, issue #101): after 5 failed password logins
# for an account or an IP, /login requires a valid hCaptcha token.
# Create a free account at https://dashboard.hcaptcha.com, add a site
# (Sites > New Site), and paste the keys here. The secret key is only
# ever used server-side; the site key is served to the mobile app by
# GET /auth/captcha/site-key so it can render the challenge widget.
HCAPTCHA_SITE_KEY=paste-your-hcaptcha-site-key-here
HCAPTCHA_SECRET_KEY=paste-your-hcaptcha-secret-key-here

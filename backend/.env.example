# Copy to backend/.env and fill in your values. Never commit .env.
JTAP_SECRET_KEY=replace-with-a-long-random-string
DATA_DIR=.
# Google Sign-In: web OAuth client ID from Google Cloud Console
# (APIs & Services > Credentials). Required for POST /auth/google.
GOOGLE_WEB_CLIENT_ID=paste-your-google-web-client-id-here
# Optional: Android / iOS OAuth client IDs. Needed once those clients exist in
# Google Cloud Console (tokens minted for them carry their own client ID).
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

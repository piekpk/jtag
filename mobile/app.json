{
    "expo":  {
                 "name":  "TrailGrid",
                 "slug":  "trailgrid",
                 "version":  "1.0.0",
                 "orientation":  "portrait",
                 "userInterfaceStyle":  "dark",
                 "ios":  {
                             "supportsTablet":  false,
                             "infoPlist":  {
                                               "NSLocationWhenInUseUsageDescription":  "TrailGrid needs your location to find rigs nearby."
                                           }
                         },
                 "android":  {
                                 "permissions":  [
                                                     "ACCESS_FINE_LOCATION",
                                                     "ACCESS_COARSE_LOCATION"
                                                 ],
                                 "config":  {
                                                "googleMaps":  {
                                                                   "apiKey":  "GMapsAPI"
                                                               }
                                            }
                             },
                 "plugins":  [
                                 "expo-router"
                             ],
                 "scheme":  "jtag"
             }
}
